# Copy to .env (gitignored) — mise.toml loads this automatically for every task.
# All values below are placeholders — this project is written generically
# and only knows the specifics of your target game through this file.

# Which site to open when you run `mise run play` (general recon/lobby).
SITE_URL=https://example-strategy-game.example

# Deep link into the active game world, used by browser-server.mjs when
# driving (not just observing). Usually SITE_URL plus a game/play path.
GAME_URL=https://example-strategy-game.example/game

# Wired up for later (e.g. auto-login), not used yet — the capture script
# doesn't know the login form's selectors until a first manual pass.
GAME_USERNAME=
GAME_PASSWORD=

# false = watch the real browser window while you play (recommended for recon).
HEADLESS=false

# Hostname suffix of the game's actual state-sync/API server (found via a
# capture session — see WORK_LOG.md), e.g. ".c.example-strategy-game.com".
# Responses from this host get a much larger body-size cap since that's
# where the real game state lives. Leave blank to disable the larger cap.
GAME_SERVER_HOST_SUFFIX=

# Comma-separated extra hostname substrings to filter out of captures as
# noise, on top of the generic ad-tech list already built in (e.g. the
# publisher's own analytics subdomain).
EXTRA_NOISE_HOSTS=

# The game's sound toggle is client-side only (a localStorage key found by
# inspecting the persisted browser profile — see WORK_LOG.md for how).
# Set both to seed it muted on every launch; leave blank to skip.
SOUND_SETTINGS_KEY=
SOUND_SETTINGS_VALUE=
